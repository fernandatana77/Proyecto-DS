# Copiar a .env para desarrollo local (`cp .env.example .env`).
# En un hosting (Render, etc.) estas variables se configuran en el panel del
# servicio, NO en un archivo. Ver la seccion "Despliegue" del README / CLAUDE.md.

# 'desarrollo' | 'produccion'. En produccion el arranque FALLA si JWT_SECRET o
# PIN_PEPPER no estan definidos o conservan un valor de ejemplo. (NODE_ENV=production
# tambien activa el modo produccion.)
ENTORNO=desarrollo

# Puerto local. En un hosting se ignora: se usa la variable PORT que inyecta el hosting.
PUERTO=3000

# Ruta del archivo SQLite (relativa a la raiz). ':memory:' para tests.
DB_RUTA=./data/inventario.db

# Secreto para firmar los JWT. CAMBIAR en produccion (cadena larga y aleatoria).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia de los tokens
JWT_EXPIRACION_STAFF=8h
JWT_EXPIRACION_EMPLEADO=20m

# "Pimienta" del HMAC del PIN. Si cambia, todos los PIN existentes dejan de validar.
# CAMBIAR en produccion (cadena larga y aleatoria).
PIN_PEPPER=cambia-esto-por-otra-cadena-larga-y-aleatoria

# 'off' para NO cargar datos demo cuando la BD arranca vacia (por defecto: se cargan).
# SEMBRAR_DEMO=off
