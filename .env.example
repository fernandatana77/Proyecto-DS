# Copiar a .env y ajustar. En produccion (ENTORNO=produccion) el arranque
# FALLA si JWT_SECRET o PIN_PEPPER conservan estos valores de ejemplo.

ENTORNO=desarrollo
PUERTO=3000

# Ruta del archivo SQLite (relativa a la raiz del proyecto). ':memory:' para tests.
DB_RUTA=./data/inventario.db

# Secreto para firmar los JWT de staff y de empleado. CAMBIAR en produccion.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia de los tokens
JWT_EXPIRACION_STAFF=8h
JWT_EXPIRACION_EMPLEADO=20m

# "Pimienta" del HMAC del PIN. Si cambia, todos los PIN existentes dejan de validar. CAMBIAR en produccion.
PIN_PEPPER=cambia-esto-por-otra-cadena-larga-y-aleatoria
